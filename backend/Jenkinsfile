pipeline {
    agent any
    
    environment {
        SONAR_TOKEN = credentials('sonar-token')
        GITHUB_TOKEN = credentials('github-pat')
        DOCKERHUB = credentials('dockerhub-cred')
        NEXUS = credentials('nexus-creds')
        DOCKER_IMAGE = 'meriembouricha/sportscenter-backend'
        TMPDIR = "/var/trivy-tmp"
        // SPRING_DATASOURCE_PASSWORD = credentials('db-password') // Commented out - using default value
        // MAIL_PASSWORD = credentials('gmail-password') // Commented out - using default value
        // STRIPE_SECRET_KEY = credentials('stripe-secret-key') // Commented out - credential not configured
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    // Clean workspace
                    cleanWs()
                    
                    // Checkout from GitHub
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/prod']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/meriembouricha/UltimateSports.git',
                            credentialsId: 'github-pat'
                        ]]
                    ])
                }
            }
        }

        stage('Determine Version') {
            steps {
                script {
                    dir('backend') {
                        // Determine short git SHA and compose image tag
                        def shortSha = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                        env.GIT_COMMIT_SHORT = shortSha
                        env.IMAGE_TAG = "${shortSha}-${env.BUILD_NUMBER}"
                        echo "Computed backend image tag: ${env.IMAGE_TAG}"
                    }
                }
            }
        }
        
        stage('Compile') {
            steps {
                dir('backend') {
                    sh 'mvn clean compile'
                }
            }
        }
        
        stage('Run Unit Tests & Coverage') {
            steps {
                dir('backend') {
                    sh 'mvn clean test jacoco:report -Dspring.profiles.active=test'
                }
            }
            post {
                always {
                    // Publish test results
                    junit 'backend/target/surefire-reports/*.xml'
                    
                    // Publish JaCoCo coverage report
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'backend/target/site/jacoco',
                        reportFiles: 'index.html',
                        reportName: 'JaCoCo Coverage Report'
                    ])
                }
            }
        }
        
        stage('Trivy File System Scan') {
            steps {
                dir('backend') {
                    sh 'trivy fs --exit-code 0 --severity HIGH,CRITICAL .'
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    // Note: 'SonarQubeServer' must match the Jenkins SonarQube server configuration name
                    withSonarQubeEnv('SonarQubeServer') {
                        sh 'mvn verify sonar:sonar -Dsonar.token=$SONAR_TOKEN -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml'
                    }
                }
            }
        }
        
        stage('Build JAR') {
            steps {
                dir('backend') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
        
        stage('Publish JAR to Nexus') {
            steps {
                dir('backend') {
                    withCredentials([usernamePassword(credentialsId: 'nexus-creds', usernameVariable: 'NEXUS_USR', passwordVariable: 'NEXUS_PSW')]) {
                        // Test connection first
                        sh "curl -u $NEXUS_USR:$NEXUS_PSW http://167.71.45.125:8081/service/rest/v1/status"
                        
                        // Deploy to Nexus
                        sh "mvn deploy -s jenkins-settings.xml"
                    }
                }
            }
        }
        
        stage('Publish Reports to Nexus (raw repo)') {
            steps {
                dir('backend') {
                    withCredentials([usernamePassword(credentialsId: 'nexus-creds', usernameVariable: 'NEXUS_USR', passwordVariable: 'NEXUS_PSW')]) {
                        script {
                            // Create archive of JaCoCo reports
                            sh "cd target/site && tar -czf jacoco-reports-${BUILD_NUMBER}.tar.gz jacoco/"
                            
                            // Upload to Nexus raw repository
                            sh """
                            curl -v -u $NEXUS_USR:$NEXUS_PSW \
                              --upload-file target/site/jacoco-reports-${BUILD_NUMBER}.tar.gz \
                              http://167.71.45.125:8081/repository/nexus-reports/jacoco-reports-${BUILD_NUMBER}.tar.gz
                            """
                            
                            // Also upload individual HTML report
                            sh """
                            curl -v -u $NEXUS_USR:$NEXUS_PSW \
                              --upload-file target/site/jacoco/index.html \
                              http://167.71.45.125:8081/repository/nexus-reports/jacoco-report-${BUILD_NUMBER}.html
                            """
                        }
                    }
                }
            }
        }
        
        stage('Build & Tag Docker Image') {
            steps {
                dir('backend') {
                    script {
                        if (!env.IMAGE_TAG) {
                            error 'IMAGE_TAG not set. Ensure Determine Version stage ran.'
                        }
                        // Build Docker image with version-specific tag
                        sh "docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} -t ${DOCKER_IMAGE}:latest ."
                        echo "Built backend image tags: ${DOCKER_IMAGE}:${IMAGE_TAG} and :latest"
                    }
                }
            }
        }
        
        stage('Trivy Docker Image Scan') {
            steps {
                sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${DOCKER_IMAGE}"
            }
        }
        
        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    // Login to Docker Hub
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-cred', usernameVariable: 'DOCKERHUB_USR', passwordVariable: 'DOCKERHUB_PSW')]) {
                        sh "echo $DOCKERHUB_PSW | docker login --username $DOCKERHUB_USR --password-stdin"
                    }
                    
                    // Push both tags
                    sh "docker push ${DOCKER_IMAGE}:${IMAGE_TAG}"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('backend') {
                    script {
                        withCredentials([file(credentialsId: 'k8s-config', variable: 'KUBECONFIG')]) {
                            sh '''
                                # Set KUBECONFIG environment variable
                                export KUBECONFIG=$KUBECONFIG
                                
                                # Verify kubectl connection
                                kubectl cluster-info
                                
                                # Apply backend deployment
                                echo "Deploying backend to Kubernetes..."
                                kubectl apply -f k8s/backend-deployment.yaml
                                
                                # Update image with versioned tag to force new rollout
                                kubectl set image deployment/backend-deployment backend=${DOCKER_IMAGE}:${IMAGE_TAG} --record
                                
                                # Apply backend service (idempotent)
                                kubectl apply -f k8s/backend-service.yaml
                                
                                # Wait for deployment to be ready
                                kubectl rollout status deployment/backend-deployment --timeout=300s || {
                                  echo "Backend deployment rollout failed" >&2
                                  kubectl describe deployment backend-deployment
                                  kubectl get pods -l app=backend -o wide
                                  exit 1
                                }
                                
                                # Get service information
                                echo "Backend service status:"
                                kubectl get services backend-service
                                
                                # Get deployment status
                                echo "Backend deployment status:"
                                kubectl get deployments backend-deployment
                                
                                # Get pods status
                                echo "Backend pods status:"
                                kubectl get pods -l app=backend
                            '''
                        }
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    try {
                        // Clean up Docker images to save space
                        sh "docker rmi ${DOCKER_IMAGE}:${IMAGE_TAG} || true"
                        sh "docker rmi ${DOCKER_IMAGE}:latest || true"
                        echo "Docker cleanup completed successfully"
                    } catch (Exception e) {
                        echo "Docker cleanup failed: ${e.getMessage()}"
                    }
                }
            }
        }
    }
    
    post {
        failure {
            echo "Pipeline failed."
        }
        success {
            echo "Pipeline completed successfully."
        }
        always {
            echo "Pipeline cleanup completed."
        }
    }
}