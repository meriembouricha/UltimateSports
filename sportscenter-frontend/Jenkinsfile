pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonar-token')
        DOCKERHUB = credentials('dockerhub-cred')
        NEXUS = credentials('nexus-creds')
        IMAGE_NAME = "sportscenter-frontend"
        VERSION = "latest"
        DOCKER_IMAGE = 'meriembouricha/sportscenter-frontend'
        TMPDIR = "/var/trivy-tmp"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    // Clean workspace
                    cleanWs()
                    
                    // Checkout from GitHub
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/prod']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/meriembouricha/UltimateSports.git',
                            credentialsId: 'github-pat'
                        ]]
                    ])
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('sportscenter-frontend') {
                    sh 'npm install'
                    sh 'npm install sonar-scanner --save-dev'
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        try {
                            // Run unit tests with resource-optimized settings for VM
                            timeout(time: 8, unit: 'MINUTES') {
                                sh '''
                                    # Set Node.js memory limit to reduce resource usage
                                    export NODE_OPTIONS="--max-old-space-size=1024"
                                    
                            # Run tests with minimal resource consumption
                            npm run test -- \
                                --watch=false \
                                --browsers=ChromeHeadless \
                                --code-coverage \
                                --progress=false \
                                --reporters=progress,coverage
                                '''
                            }
                        } catch (Exception e) {
                            echo "Unit tests failed: ${e.getMessage()}"
                            currentBuild.result = 'UNSTABLE'
                            throw e
                        }
                    }
                }
            }
            post {
                always {
                    // Clean up temporary files to free up space
                    sh '''
                        # Clean up node_modules cache and temporary files
                        rm -rf node_modules/.cache || true
                        rm -rf .angular/cache || true
                        rm -rf coverage/.nyc_output || true
                        
                        # Clear npm cache
                        npm cache clean --force || true
                    '''
                    
                    // Publish test results (JUnit format)
                    publishTestResults testResultsPattern: 'sportscenter-frontend/coverage/test-results.xml'
                    
                    // Publish coverage reports
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'sportscenter-frontend/coverage',
                        reportFiles: 'index.html',
                        reportName: 'Unit Test Coverage Report'
                    ])
                    
                    // Archive test artifacts
                    archiveArtifacts artifacts: 'sportscenter-frontend/coverage/**/*', allowEmptyArchive: true
                }
                success {
                    echo "Unit tests completed successfully"
                }
                failure {
                    echo "Unit tests failed - check the test results"
                }
            }
        }

        stage('Build App') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        // Build with resource-optimized settings for VM
                        sh '''
                            # Set Node.js memory limit for build process
                            export NODE_OPTIONS="--max-old-space-size=1024"
                            
                            # Build with minimal resource consumption
                            npm run build -- --configuration=development
                        '''
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('sportscenter-frontend') {
                    // Note: 'SonarQubeServer' must match the Jenkins SonarQube server configuration name
                    withSonarQubeEnv('SonarQubeServer') {
                        sh """
                            npx sonar-scanner \
                            -Dsonar.projectKey=sportscenter-frontend \
                            -Dsonar.sources=src \
                            -Dsonar.host.url=http://139.59.150.186:9000 \
                            -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Publish Test Reports to Nexus') {
            steps {
                dir('sportscenter-frontend') {
                    withCredentials([usernamePassword(credentialsId: 'nexus-creds', usernameVariable: 'NEXUS_USR', passwordVariable: 'NEXUS_PSW')]) {
                        script {
                            // Create test reports archive
                            sh "cd coverage && tar -czf test-reports-${BUILD_NUMBER}.tar.gz ."
                            
                            // Upload test reports to Nexus
                            sh """
                                curl -v -u $NEXUS_USR:$NEXUS_PSW \
                                  --upload-file coverage/test-reports-${BUILD_NUMBER}.tar.gz \
                                  http://139.59.150.186:8081/repository/nexus-reports/frontend-test-reports-${BUILD_NUMBER}.tar.gz
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                dir('sportscenter-frontend') {
                    sh 'trivy fs --exit-code 0 --severity HIGH,CRITICAL .'
                }
            }
        }

        stage('Build & Tag Docker Image') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        // Build Docker image
                        sh "docker build -t ${IMAGE_NAME} ."
                        
                        // Tag the image
                        sh "docker tag ${IMAGE_NAME} ${DOCKER_IMAGE}"
                    }
                }
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {
                sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${DOCKER_IMAGE}"
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    // Login to Docker Hub
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-cred', usernameVariable: 'DOCKERHUB_USR', passwordVariable: 'DOCKERHUB_PSW')]) {
                        sh "echo $DOCKERHUB_PSW | docker login --username $DOCKERHUB_USR --password-stdin"
                    }
                    
                    // Push the image
                    sh "docker push ${DOCKER_IMAGE}"
                }
            }
        }
    }

    post {
        failure {
            echo "Pipeline failed."
        }
        success {
            echo "Pipeline completed successfully."
        }
        always {
            // Clean up Docker images and workspace
            script {
                try {
                    // Clean up Docker images to save space
                    sh "docker rmi ${IMAGE_NAME} || true"
                    sh "docker rmi ${DOCKER_IMAGE} || true"
                    
                    // Clean up workspace to free up disk space
                    sh '''
                        # Clean up frontend build artifacts
                        rm -rf sportscenter-frontend/dist || true
                        rm -rf sportscenter-frontend/node_modules/.cache || true
                        rm -rf sportscenter-frontend/.angular/cache || true
                        rm -rf sportscenter-frontend/coverage/.nyc_output || true
                        
                        # Clean up npm cache
                        cd sportscenter-frontend && npm cache clean --force || true
                        
                        # Clean up any temporary files
                        find . -name "*.tmp" -delete || true
                        find . -name "*.log" -delete || true
                    '''
                } catch (Exception e) {
                    echo "Cleanup failed: ${e.getMessage()}"
                }
            }
        }
    }
}
