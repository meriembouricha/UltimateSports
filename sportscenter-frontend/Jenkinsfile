pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonar-token')
        DOCKERHUB = credentials('dockerhub-cred')
        NEXUS = credentials('nexus-creds')
        IMAGE_NAME = "sportscenter-frontend"
        VERSION = "latest"
        DOCKER_IMAGE = 'meriembouricha/sportscenter-frontend'
        TMPDIR = "/var/trivy-tmp"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    // Clean workspace
                    cleanWs()
                    
                    // Checkout from GitHub
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/prod']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/meriembouricha/UltimateSports.git',
                            credentialsId: 'github-pat'
                        ]]
                    ])
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                            // Install dependencies with memory optimization and timeout
                            timeout(time: 10, unit: 'MINUTES') {
                                sh '''
                                    # Set Node.js memory limit for npm install
                                    export NODE_OPTIONS="--max-old-space-size=1024"
                                    
                                    # Monitor memory usage
                                    echo "Available memory before npm install:"
                                    free -h
                                    
                                    # Clean up any existing node_modules to free space
                                    rm -rf node_modules || true
                                    rm -rf .angular/cache || true
                                    
                                    # Clean npm cache first
                                    npm cache clean --force || true
                                    
                                    # Install dependencies with reduced memory usage
                                    echo "Installing dependencies..."
                                    npm install --no-audit --no-fund --prefer-offline --progress=false
                                    
                                    # Install sonar-scanner and browser launchers
                                    echo "Installing additional packages..."
                                    npm install sonar-scanner karma-firefox-launcher karma-phantomjs-launcher --save-dev --no-audit --no-fund --progress=false
                                    
                                    # Check memory usage after install
                                    echo "Available memory after npm install:"
                                    free -h
                                '''
                            }
                    }
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        try {
                            // Run unit tests with browser detection and execution in one script
                            timeout(time: 8, unit: 'MINUTES') {
                                sh '''
                                    # Set Node.js memory limit to reduce resource usage
                                    export NODE_OPTIONS="--max-old-space-size=1024"
                                    
                                    # Initialize browser variables
                                    CHROME_BIN=""
                                    FIREFOX_BIN=""
                                    BROWSER_TYPE=""
                                    
                                    echo "Starting browser detection..."
                                    
                                    # Check if Chrome is already available
                                    if command -v google-chrome >/dev/null 2>&1; then
                                        CHROME_PATH=$(which google-chrome)
                                        echo "Chrome found at: $CHROME_PATH"
                                        CHROME_BIN="$CHROME_PATH"
                                        BROWSER_TYPE="chrome"
                                    elif command -v chromium-browser >/dev/null 2>&1; then
                                        CHROME_PATH=$(which chromium-browser)
                                        echo "Chromium found at: $CHROME_PATH"
                                        CHROME_BIN="$CHROME_PATH"
                                        BROWSER_TYPE="chrome"
                                    elif command -v chromium >/dev/null 2>&1; then
                                        CHROME_PATH=$(which chromium)
                                        echo "Chromium found at: $CHROME_PATH"
                                        CHROME_BIN="$CHROME_PATH"
                                        BROWSER_TYPE="chrome"
                                    else
                                        echo "No Chrome/Chromium found, skipping installation (requires sudo password)"
                                        CHROME_BIN=""
                                    fi
                                    
                                    # Check for Firefox if Chrome is not available
                                    if [ -z "$BROWSER_TYPE" ]; then
                                        if command -v firefox >/dev/null 2>&1; then
                                            FIREFOX_PATH=$(which firefox)
                                            echo "Firefox found at: $FIREFOX_PATH"
                                            FIREFOX_BIN="$FIREFOX_PATH"
                                            BROWSER_TYPE="firefox"
                                        elif command -v firefox-esr >/dev/null 2>&1; then
                                            FIREFOX_PATH=$(which firefox-esr)
                                            echo "Firefox ESR found at: $FIREFOX_PATH"
                                            FIREFOX_BIN="$FIREFOX_PATH"
                                            BROWSER_TYPE="firefox"
                                        else
                                            echo "No Firefox found, skipping installation (requires sudo password)"
                                            FIREFOX_BIN=""
                                        fi
                                    fi
                                    
                                    # Debug output
                                    echo "Browser detection complete:"
                                    echo "  BROWSER_TYPE: $BROWSER_TYPE"
                                    echo "  CHROME_BIN: $CHROME_BIN"
                                    echo "  FIREFOX_BIN: $FIREFOX_BIN"
                                    
                                    # Verify browser binary exists and run tests
                                    if [ "$BROWSER_TYPE" = "chrome" ] && [ -n "$CHROME_BIN" ] && [ -f "$CHROME_BIN" ]; then
                                        echo "Chrome binary verified at: $CHROME_BIN"
                                        export CHROME_BIN="$CHROME_BIN"
                                        echo "Running tests with Chrome at: $CHROME_BIN"
                                        npm run test -- \
                                            --watch=false \
                                            --browsers=ChromeHeadless \
                                            --code-coverage \
                                            --progress=false \
                                            --reporters=progress,coverage
                                    elif [ "$BROWSER_TYPE" = "firefox" ] && [ -n "$FIREFOX_BIN" ] && [ -f "$FIREFOX_BIN" ]; then
                                        echo "Firefox binary verified at: $FIREFOX_BIN"
                                        export FIREFOX_BIN="$FIREFOX_BIN"
                                        echo "Running tests with Firefox at: $FIREFOX_BIN"
                                        npm run test -- \
                                            --watch=false \
                                            --browsers=FirefoxHeadless \
                                            --code-coverage \
                                            --progress=false \
                                            --reporters=progress,coverage
                                    else
                                        echo "No suitable browser found, trying to run tests with default configuration"
                                        # Run tests without specifying a browser (uses default from karma.conf.js)
                                        npm run test -- \
                                            --watch=false \
                                            --code-coverage \
                                            --progress=false \
                                            --reporters=progress,coverage
                                    fi
                                '''
                            }
                        } catch (Exception e) {
                            echo "Unit tests failed: ${e.getMessage()}"
                            currentBuild.result = 'UNSTABLE'
                            throw e
                        }
                    }
                }
            }
            post {
                always {
                    // Clean up temporary files to free up space
                    sh '''
                        # Clean up node_modules cache and temporary files
                        rm -rf node_modules/.cache || true
                        rm -rf .angular/cache || true
                        rm -rf coverage/.nyc_output || true
                        
                        # Clear npm cache
                        npm cache clean --force || true
                    '''
                    
                    // Publish coverage reports
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'sportscenter-frontend/coverage',
                        reportFiles: 'index.html',
                        reportName: 'Unit Test Coverage Report'
                    ])
                    
                    // Archive test artifacts
                    archiveArtifacts artifacts: 'sportscenter-frontend/coverage/**/*', allowEmptyArchive: true
                }
                success {
                    echo "Unit tests completed successfully"
                }
                failure {
                    echo "Unit tests failed - check the test results"
                }
            }
        }

        stage('Build App') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        // Build with resource-optimized settings for VM
                        sh '''
                            # Set Node.js memory limit for build process
                            export NODE_OPTIONS="--max-old-space-size=1024"
                            
                            # Build with minimal resource consumption
                            npm run build -- --configuration=development
                        '''
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('sportscenter-frontend') {
                    // Note: 'SonarQubeServer' must match the Jenkins SonarQube server configuration name
                    withSonarQubeEnv('SonarQubeServer') {
                        sh """
                            npx sonar-scanner \
                            -Dsonar.projectKey=sportscenter-frontend \
                            -Dsonar.sources=src \
                            -Dsonar.host.url=http://139.59.150.186:9000 \
                            -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Publish Test Reports to Nexus') {
            steps {
                dir('sportscenter-frontend') {
                    withCredentials([usernamePassword(credentialsId: 'nexus-creds', usernameVariable: 'NEXUS_USR', passwordVariable: 'NEXUS_PSW')]) {
                        script {
                            // Create test reports archive
                            sh "cd coverage && tar -czf test-reports-${BUILD_NUMBER}.tar.gz ."
                            
                            // Upload test reports to Nexus
                            sh """
                                curl -v -u $NEXUS_USR:$NEXUS_PSW \
                                  --upload-file coverage/test-reports-${BUILD_NUMBER}.tar.gz \
                                  http://139.59.150.186:8081/repository/nexus-reports/frontend-test-reports-${BUILD_NUMBER}.tar.gz
                            """
                        }
                    }
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                dir('sportscenter-frontend') {
                    sh 'trivy fs --exit-code 0 --severity HIGH,CRITICAL .'
                }
            }
        }

        stage('Build & Tag Docker Image') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        // Build Docker image
                        sh "docker build -t ${IMAGE_NAME} ."
                        
                        // Tag the image
                        sh "docker tag ${IMAGE_NAME} ${DOCKER_IMAGE}"
                    }
                }
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {
                sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${DOCKER_IMAGE}"
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    // Login to Docker Hub
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-cred', usernameVariable: 'DOCKERHUB_USR', passwordVariable: 'DOCKERHUB_PSW')]) {
                        sh "echo $DOCKERHUB_PSW | docker login --username $DOCKERHUB_USR --password-stdin"
                    }
                    
                    // Push the image
                    sh "docker push ${DOCKER_IMAGE}"
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    try {
                        // Clean up Docker images to save space
                        sh "docker rmi ${IMAGE_NAME} || true"
                        sh "docker rmi ${DOCKER_IMAGE} || true"
                        
                        // Clean up workspace to free up disk space
                        sh '''
                            # Clean up frontend build artifacts
                            rm -rf sportscenter-frontend/dist || true
                            rm -rf sportscenter-frontend/node_modules/.cache || true
                            rm -rf sportscenter-frontend/.angular/cache || true
                            rm -rf sportscenter-frontend/coverage/.nyc_output || true
                            
                            # Clean up npm cache
                            cd sportscenter-frontend && npm cache clean --force || true
                            
                            # Clean up any temporary files
                            find . -name "*.tmp" -delete || true
                            find . -name "*.log" -delete || true
                        '''
                        echo "Cleanup completed successfully"
                    } catch (Exception e) {
                        echo "Cleanup failed: ${e.getMessage()}"
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Pipeline failed."
        }
        success {
            echo "Pipeline completed successfully."
        }
        always {
            echo "Pipeline cleanup completed."
        }
    }
}
