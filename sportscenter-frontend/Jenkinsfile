pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonar-token')
        DOCKERHUB = credentials('dockerhub-cred')
        NEXUS = credentials('nexus-creds')
        IMAGE_NAME = "sportscenter-frontend"
        VERSION = "latest"
        DOCKER_IMAGE = 'meriembouricha/sportscenter-frontend'
        TMPDIR = "/var/trivy-tmp"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    // Clean workspace
                    cleanWs()
                    
                    // Checkout from GitHub
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/prod']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/meriembouricha/UltimateSports.git',
                            credentialsId: 'github-pat'
                        ]]
                    ])
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('sportscenter-frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Build App') {
            steps {
                dir('sportscenter-frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('sportscenter-frontend') {
                    // Note: 'SonarQubeServer' must match the Jenkins SonarQube server configuration name
                    withSonarQubeEnv('SonarQubeServer') {
                        sh """
                            sonar-scanner \
                            -Dsonar.projectKey=sportscenter-frontend \
                            -Dsonar.sources=src \
                            -Dsonar.host.url=http://139.59.150.186:9000 \
                            -Dsonar.login=${SONAR_TOKEN}
                        """
                    }
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                dir('sportscenter-frontend') {
                    sh 'trivy fs --exit-code 0 --severity HIGH,CRITICAL .'
                }
            }
        }

        stage('Build & Tag Docker Image') {
            steps {
                dir('sportscenter-frontend') {
                    script {
                        // Build Docker image
                        sh "docker build -t ${IMAGE_NAME} ."
                        
                        // Tag the image
                        sh "docker tag ${IMAGE_NAME} ${DOCKER_IMAGE}"
                    }
                }
            }
        }

        stage('Trivy Docker Image Scan') {
            steps {
                sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${DOCKER_IMAGE}"
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                script {
                    // Login to Docker Hub
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-cred', usernameVariable: 'DOCKERHUB_USR', passwordVariable: 'DOCKERHUB_PSW')]) {
                        sh "echo $DOCKERHUB_PSW | docker login --username $DOCKERHUB_USR --password-stdin"
                    }
                    
                    // Push the image
                    sh "docker push ${DOCKER_IMAGE}"
                }
            }
        }
    }

    post {
        failure {
            echo "Pipeline failed."
        }
        success {
            echo "Pipeline completed successfully."
        }
        always {
            // Clean up Docker images to save space
            sh "docker rmi ${IMAGE_NAME} || true"
            sh "docker rmi ${DOCKER_IMAGE} || true"
        }
    }
}
